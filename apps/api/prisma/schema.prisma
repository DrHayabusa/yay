// Sanad platform — relational data model.
// Conventions: cuid ids, createdAt/updatedAt everywhere, Decimal(12,2) money,
// soft delete (deletedAt) on user-facing catalogue/party tables,
// onDelete: Restrict on money/state tables to protect the audit trail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  RECOVERY_DRIVER
  PROVIDER_ADMIN
  GARAGE_TECHNICIAN
  GARAGE_MANAGER
  SUPPLIER
  DELIVERY_DRIVER
  ADMIN
  SUPPORT_AGENT
  QC_INSPECTOR
}

enum CaseStatus {
  REQUEST_CREATED
  AWAITING_RECOVERY_ASSIGNMENT
  RECOVERY_ASSIGNED
  RECOVERY_EN_ROUTE
  RECOVERY_ARRIVED
  VEHICLE_COLLECTED
  VEHICLE_IN_TRANSIT
  VEHICLE_AT_GARAGE
  INSPECTION_IN_PROGRESS
  DIAGNOSIS_SUBMITTED
  AWAITING_CUSTOMER_APPROVAL
  PARTS_SELECTION_REQUIRED
  PARTS_ORDERED
  PARTS_DISPATCHED
  PARTS_DELIVERED
  REPAIR_IN_PROGRESS
  QUALITY_CHECK_IN_PROGRESS
  REPAIR_COMPLETED
  DELIVERY_SCHEDULED
  VEHICLE_OUT_FOR_DELIVERY
  VEHICLE_DELIVERED
  CASE_CLOSED
  CANCELLED
  DISPUTED
}

enum RequestType {
  BREAKDOWN
  INSPECTION_ONLY
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  PICKUP_HANDOVER
  DELIVERY_HANDOVER
  ACCOUNT_DELETION
}

enum MediaKind {
  VEHICLE_PHOTO
  VEHICLE_VIDEO
  PLATE_PHOTO
  VOICE_NOTE
  DAMAGE_PHOTO
  EVIDENCE
  DOCUMENT
  BEFORE_PICKUP
  AFTER_REPAIR
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum HandoverType {
  PICKUP
  GARAGE_DELIVERY
  CUSTOMER_DELIVERY
}

enum FindingSeverity {
  CRITICAL
  MAJOR
  MINOR
  ADVISORY
}

enum RepairItemStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  DONE
}

enum QuotationStatus {
  DRAFT
  PUBLISHED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuotationItemType {
  LABOUR
  PART
  FEE
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PartCondition {
  OEM_GENUINE
  AFTERMARKET_PREMIUM
  AFTERMARKET_STANDARD
  USED_REFURBISHED
}

enum PartOrderStatus {
  PENDING_COMPATIBILITY
  CONFIRMED
  DISPATCHED
  DELIVERED
  REJECTED
  RETURNED
  CANCELLED
}

enum PaymentKind {
  RECOVERY
  DIAGNOSTIC
  REPAIR
  PARTS
  DELIVERY
  PLATFORM_FEE
  DEPOSIT
}

enum PaymentStatus {
  REQUIRES_ACTION
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum SettlementStatus {
  PENDING
  PAID
  ON_HOLD
}

enum PayeeType {
  RECOVERY_PROVIDER
  GARAGE
  SUPPLIER
  DELIVERY
}

enum NotificationChannel {
  PUSH
  SMS
  IN_APP
}

enum QcResult {
  PASSED
  FAILED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CUSTOMER
  RESOLVED_PROVIDER
  CLOSED
}

enum LocationSource {
  CUSTOMER_APP
  DRIVER_APP
  ADMIN
  SYSTEM
}

// ---------- Identity & parties ----------

model User {
  id           String    @id @default(cuid())
  phone        String    @unique // E.164, e.g. +9715XXXXXXXX
  email        String?   @unique
  passwordHash String? // optional: phone-OTP-first auth
  fullName     String
  language     String    @default("en") // en | ar
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  otpCodes          OtpCode[]
  customerProfile   CustomerProfile?
  driver            Driver?
  technician        Technician?
  notifications     Notification[]
  statusChanges     StatusHistory[]
  approvals         CustomerApproval[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  chatMessages      ChatMessage[]
  ratingsGiven      Rating[]
  complaints        Complaint[]
  providerProfile   ProviderProfile?   @relation(fields: [providerProfileId], references: [id])
  providerProfileId String?
  garage            Garage?            @relation(fields: [garageId], references: [id])
  garageId          String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  supplierId        String?

  @@index([deletedAt])
}

model UserRole {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // sha256 of the token — raw token never stored
  familyId  String // rotation family; reuse of a revoked member revokes the family
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model OtpCode {
  id         String     @id @default(cuid())
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  phone      String // target phone (user may not exist yet at registration)
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

model CustomerProfile {
  id                 String    @id @default(cuid())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String    @unique
  emiratesIdVerified Boolean   @default(false) // via approved KYC provider (post-MVP)
  defaultEmirate     String? // e.g. Dubai, Sharjah
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  vehicles           Vehicle[]
}

model ProviderProfile {
  id                 String             @id @default(cuid())
  companyName        String
  tradeLicenceNo     String
  tradeLicenceDocKey String? // S3 key
  phone              String
  email              String?
  verification       VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  commissionRate     Decimal            @default(0.15) @db.Decimal(5, 4)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users            User[]
  drivers          Driver[]
  recoveryVehicles RecoveryVehicle[]

  @@index([verification])
}

model Driver {
  id              String          @id @default(cuid())
  user            User            @relation(fields: [userId], references: [id])
  userId          String          @unique
  provider        ProviderProfile @relation(fields: [providerId], references: [id])
  providerId      String
  licenceNo       String
  licenceExpiry   DateTime?
  isAvailable     Boolean         @default(false)
  lastLat         Decimal?        @db.Decimal(9, 6)
  lastLng         Decimal?        @db.Decimal(9, 6)
  lastLocationAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assignments     RecoveryAssignment[]
  deliveries      DeliveryAssignment[]

  @@index([providerId, isAvailable])
}

model RecoveryVehicle {
  id           String             @id @default(cuid())
  provider     ProviderProfile    @relation(fields: [providerId], references: [id])
  providerId   String
  plateNumber  String
  truckType    String // flatbed | wheel-lift | heavy
  capacityKg   Int?
  verification VerificationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  RecoveryAssignment[]

  @@unique([providerId, plateNumber])
}

model Garage {
  id                 String             @id @default(cuid())
  name               String
  tradeLicenceNo     String
  tradeLicenceDocKey String?
  phone              String
  email              String?
  emirate            String
  address            String
  lat                Decimal            @db.Decimal(9, 6)
  lng                Decimal            @db.Decimal(9, 6)
  dailyCapacity      Int                @default(10)
  verification       VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  commissionRate     Decimal            @default(0.10) @db.Decimal(5, 4)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users           User[]
  technicians     Technician[]
  serviceRequests ServiceRequest[]

  @@index([verification])
  @@index([emirate])
}

model Technician {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id])
  userId      String       @unique
  garage      Garage       @relation(fields: [garageId], references: [id])
  garageId    String
  speciality  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inspections Inspection[]

  @@index([garageId])
}

model Supplier {
  id                 String             @id @default(cuid())
  name               String
  tradeLicenceNo     String
  phone              String
  email              String?
  emirate            String
  verification       VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  commissionRate     Decimal            @default(0.08) @db.Decimal(5, 4)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users      User[]
  inventory  SupplierInventory[]
  partOrders PartOrder[]

  @@index([verification])
}

// ---------- Vehicles ----------

model Vehicle {
  id            String            @id @default(cuid())
  owner         CustomerProfile   @relation(fields: [ownerId], references: [id])
  ownerId       String
  make          String
  model         String
  year          Int
  vin           String?
  plateEmirate  String // Dubai | Sharjah | ...
  plateCode     String // e.g. A, B, 1, 2 ...
  plateNumber   String
  engine        String?
  color         String?
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  documents     VehicleDocument[]
  serviceRequests ServiceRequest[]

  // VIN uniqueness among non-deleted rows is enforced by a partial unique
  // index added in raw SQL migration (Prisma cannot express partial indexes).
  @@index([ownerId, deletedAt])
  @@index([vin])
  @@index([plateEmirate, plateCode, plateNumber])
}

model VehicleDocument {
  id         String   @id @default(cuid())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  String
  kind       String // registration_card | insurance | other
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([vehicleId])
}

// ---------- Case core ----------

model ServiceRequest {
  id             String      @id @default(cuid())
  customerId     String // CustomerProfile id (denormalised owner check)
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId      String
  type           RequestType @default(BREAKDOWN)
  status         CaseStatus  @default(REQUEST_CREATED)
  description    String?
  canMove        Boolean
  isSafeLocation Boolean
  emergencyFlags String[]    @default([])
  pickupLat      Decimal     @db.Decimal(9, 6)
  pickupLng      Decimal     @db.Decimal(9, 6)
  pickupAddress  String?
  garage         Garage?     @relation(fields: [garageId], references: [id], onDelete: Restrict)
  garageId       String?
  disputeFrozen  Boolean     @default(false)

  estimatedRecoveryFee Decimal? @db.Decimal(12, 2)
  estimatedEtaMinutes  Int?
  diagnosticFee        Decimal? @db.Decimal(12, 2)
  currency             String   @default("AED")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  media              ServiceRequestMedia[]
  locations          Location[]
  statusHistory      StatusHistory[]
  recoveryAssignments RecoveryAssignment[]
  handovers          VehicleHandover[]
  inspections        Inspection[]
  quotations         Quotation[]
  partOrders         PartOrder[]
  payments           Payment[]
  invoices           Invoice[]
  qualityInspections QualityInspection[]
  deliveryAssignments DeliveryAssignment[]
  warranties         Warranty[]
  ratings            Rating[]
  complaints         Complaint[]
  disputes           Dispute[]
  chatConversation   ChatConversation?

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([garageId, status])
}

model ServiceRequestMedia {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  uploaderUserId   String
  kind             MediaKind
  storageKey       String         @unique
  mimeType         String
  sizeBytes        Int
  scanStatus       ScanStatus     @default(PENDING)
  exifLat          Decimal?       @db.Decimal(9, 6)
  exifLng          Decimal?       @db.Decimal(9, 6)
  capturedAt       DateTime?
  createdAt        DateTime       @default(now())
  statusHistory    StatusHistory[] @relation("StatusEvidence")

  @@index([serviceRequestId, kind])
}

model Location {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceRequestId String
  lat              Decimal        @db.Decimal(9, 6)
  lng              Decimal        @db.Decimal(9, 6)
  source           LocationSource
  actorUserId      String?
  recordedAt       DateTime       @default(now())

  @@index([serviceRequestId, recordedAt])
}

model StatusHistory {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  fromStatus       CaseStatus?
  toStatus         CaseStatus
  actor            User?          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorUserId      String?
  actorRole        Role?
  isSystem         Boolean        @default(false)
  isOverride       Boolean        @default(false)
  lat              Decimal?       @db.Decimal(9, 6)
  lng              Decimal?       @db.Decimal(9, 6)
  notes            String?
  evidence         ServiceRequestMedia[] @relation("StatusEvidence")
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId, createdAt])
}

// ---------- Recovery ----------

model RecoveryAssignment {
  id                String           @id @default(cuid())
  serviceRequest    ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId  String
  driver            Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId          String
  recoveryVehicle   RecoveryVehicle? @relation(fields: [recoveryVehicleId], references: [id], onDelete: Restrict)
  recoveryVehicleId String?
  status            AssignmentStatus @default(OFFERED)
  offeredAt         DateTime         @default(now())
  respondedAt       DateTime?
  distanceKm        Decimal?         @db.Decimal(8, 2)
  fee               Decimal?         @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([driverId, status])
  @@index([serviceRequestId, status])
}

model VehicleHandover {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  type             HandoverType
  otpHash          String?
  otpExpiresAt     DateTime?
  otpAttempts      Int            @default(0)
  verifiedAt       DateTime?
  verifiedByUserId String?
  overrideReason   String? // admin-approved customer-absent override
  signatureKey     String? // S3 key of signature image
  lat              Decimal?       @db.Decimal(9, 6)
  lng              Decimal?       @db.Decimal(9, 6)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([serviceRequestId, type])
}

// ---------- Garage flow ----------

model Inspection {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  technician       Technician     @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  technicianId     String
  checklist        Json? // structured checklist answers
  odometerKm       Int?
  startedAt        DateTime       @default(now())
  submittedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  findings         DiagnosticFinding[]

  @@index([serviceRequestId])
}

model DiagnosticFinding {
  id                   String          @id @default(cuid())
  inspection           Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  inspectionId         String
  title                String
  technicalDetail      String
  plainLanguageSummary String // customer-facing, simple language
  severity             FindingSeverity
  evidenceMediaIds     String[]        @default([])
  createdAt            DateTime        @default(now())
  repairItems          RepairItem[]

  @@index([inspectionId])
}

model RepairItem {
  id              String            @id @default(cuid())
  finding         DiagnosticFinding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  findingId       String
  description     String
  labourHours     Decimal           @db.Decimal(6, 2)
  status          RepairItemStatus  @default(PENDING)
  requiresPart    Boolean           @default(false)
  replacedPartNote String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  quotationItems  QuotationItem[]

  @@index([findingId])
}

model QualityInspection {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  inspectorUserId  String
  checklist        Json
  result           QcResult
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
}

// ---------- Commerce: quotations & approvals ----------

model Quotation {
  id               String          @id @default(cuid())
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  version          Int             @default(1)
  status           QuotationStatus @default(DRAFT)
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  vatAmount        Decimal         @default(0) @db.Decimal(12, 2)
  platformFee      Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @default(0) @db.Decimal(12, 2)
  currency         String          @default("AED")
  estimatedCompletionHours Int?
  publishedAt      DateTime?
  finalizedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            QuotationItem[]

  @@unique([serviceRequestId, version])
  @@index([serviceRequestId, status])
}

model QuotationItem {
  id              String            @id @default(cuid())
  quotation       Quotation         @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationId     String
  type            QuotationItemType
  title           String
  plainLanguageSummary String?
  repairItem      RepairItem?       @relation(fields: [repairItemId], references: [id], onDelete: Restrict)
  repairItemId    String?
  requiresPart    Boolean           @default(false)
  quantity        Int               @default(1)
  unitPrice       Decimal           @db.Decimal(12, 2)
  lineTotal       Decimal           @db.Decimal(12, 2)
  selectedInventory   SupplierInventory? @relation(fields: [selectedInventoryId], references: [id], onDelete: Restrict)
  selectedInventoryId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approval        CustomerApproval?
  partOrderItems  PartOrderItem[]

  @@index([quotationId])
}

model CustomerApproval {
  id              String           @id @default(cuid())
  quotationItem   QuotationItem    @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  quotationItemId String           @unique
  customer        User             @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  customerUserId  String
  decision        ApprovalDecision
  ipAddress       String?
  deviceInfo      String?
  createdAt       DateTime         @default(now()) // immutable: no updatedAt by design

  @@index([customerUserId])
}

// ---------- Commerce: parts marketplace ----------

model SparePart {
  id         String    @id @default(cuid())
  oemNumber  String?
  name       String
  category   String // brakes | cooling | engine | electrical | ...
  usedAllowed Boolean  @default(false) // legal review gate for used/refurb sales
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  compatibility PartCompatibility[]
  inventory     SupplierInventory[]

  @@index([oemNumber])
  @@index([category])
}

model PartCompatibility {
  id              String    @id @default(cuid())
  sparePart       SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  sparePartId     String
  make            String
  model           String
  yearFrom        Int
  yearTo          Int
  engine          String? // null = all engines for that model
  verifiedByUserId String? // platform/garage verifier
  createdAt       DateTime  @default(now())

  @@unique([sparePartId, make, model, yearFrom, yearTo, engine])
  @@index([make, model])
}

model SupplierInventory {
  id               String        @id @default(cuid())
  supplier         Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId       String
  sparePart        SparePart     @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  sparePartId      String
  condition        PartCondition
  brand            String
  price            Decimal       @db.Decimal(12, 2)
  currency         String        @default("AED")
  stockQty         Int           @default(0)
  warrantyMonths   Int           @default(0)
  deliveryEtaHours Int           @default(24)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  quotationItems   QuotationItem[]
  orderItems       PartOrderItem[]

  @@unique([supplierId, sparePartId, condition])
  @@index([sparePartId, condition])
}

model PartOrder {
  id               String          @id @default(cuid())
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId       String
  status           PartOrderStatus @default(PENDING_COMPATIBILITY)
  // Compatibility gate: both fields must be set before status may become CONFIRMED.
  compatibilityConfirmedByUserId String?
  compatibilityConfirmedAt       DateTime?
  subtotal         Decimal         @db.Decimal(12, 2)
  deliveryFee      Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  currency         String          @default("AED")
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  garageReceiptByUserId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            PartOrderItem[]

  @@index([serviceRequestId])
  @@index([supplierId, status])
}

model PartOrderItem {
  id              String            @id @default(cuid())
  order           PartOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId         String
  inventory       SupplierInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  inventoryId     String
  quotationItem   QuotationItem?    @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  quotationItemId String?
  quantity        Int
  unitPrice       Decimal           @db.Decimal(12, 2)
  lineTotal       Decimal           @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())

  @@index([orderId])
}

// ---------- Money ----------

model Payment {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  payerUserId      String
  kind             PaymentKind
  status           PaymentStatus  @default(PENDING)
  provider         String // mock | stripe | telr | ...
  providerIntentId String?        @unique
  idempotencyKey   String         @unique
  subtotal         Decimal        @db.Decimal(12, 2)
  vatAmount        Decimal        @db.Decimal(12, 2)
  platformFee      Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  currency         String         @default("AED")
  capturedAt       DateTime?
  failureCode      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refunds          Refund[]

  @@index([serviceRequestId, kind])
  @@index([payerUserId])
}

model Refund {
  id              String       @id @default(cuid())
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId       String
  status          RefundStatus @default(REQUESTED)
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("AED")
  reason          String
  requestedByUserId String
  approvedByUserId  String?
  providerRefundId  String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([paymentId])
  @@index([status])
}

model Settlement {
  id          String           @id @default(cuid())
  payeeType   PayeeType
  payeeId     String // ProviderProfile/Garage/Supplier id
  periodStart DateTime
  periodEnd   DateTime
  gross       Decimal          @db.Decimal(12, 2)
  commission  Decimal          @db.Decimal(12, 2)
  net         Decimal          @db.Decimal(12, 2)
  currency    String           @default("AED")
  status      SettlementStatus @default(PENDING)
  paidAt      DateTime?
  reference   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([payeeType, payeeId, status])
}

model Invoice {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  number           String         @unique // sequential, e.g. INV-2026-000123
  lineSnapshot     Json // immutable copy of billed lines
  subtotal         Decimal        @db.Decimal(12, 2)
  vatAmount        Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  currency         String         @default("AED")
  pdfKey           String?
  issuedAt         DateTime       @default(now())
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
}

model Warranty {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  scope            String // e.g. "Front brake pads + labour"
  months           Int
  terms            String
  startsAt         DateTime
  endsAt           DateTime
  issuedByGarageId String?
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
}

// ---------- Delivery back to customer ----------

model DeliveryAssignment {
  id               String           @id @default(cuid())
  serviceRequest   ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  driver           Driver?          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId         String?
  status           AssignmentStatus @default(OFFERED)
  scheduledFor     DateTime?
  dropLat          Decimal?         @db.Decimal(9, 6)
  dropLng          Decimal?         @db.Decimal(9, 6)
  dropAddress      String?
  fee              Decimal?         @db.Decimal(12, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([serviceRequestId])
  @@index([driverId, status])
}

// ---------- Engagement & ops ----------

model Notification {
  id          String                @id @default(cuid())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  messageCode String // e.g. CASE_STATUS:RECOVERY_ASSIGNED — clients localise
  params      Json?
  channels    NotificationChannel[]
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  @@index([userId, readAt])
}

model ChatConversation {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String         @unique
  createdAt        DateTime       @default(now())
  messages         ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  conversationId String
  sender         User             @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  senderUserId   String
  body           String
  mediaKey       String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Rating {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  rater            User           @relation(fields: [raterUserId], references: [id], onDelete: Restrict)
  raterUserId      String
  rateeType        PayeeType // recovery provider | garage | supplier | delivery
  rateeId          String
  stars            Int // 1..5, CHECK constraint in migration
  comment          String?
  createdAt        DateTime       @default(now())

  @@unique([serviceRequestId, raterUserId, rateeType, rateeId])
  @@index([rateeType, rateeId])
}

model Complaint {
  id               String          @id @default(cuid())
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String?
  raisedBy         User            @relation(fields: [raisedByUserId], references: [id], onDelete: Restrict)
  raisedByUserId   String
  subject          String
  body             String
  status           ComplaintStatus @default(OPEN)
  assignedAgentId  String?
  resolutionNote   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt])
}

model Dispute {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceRequestId String
  openedByUserId   String
  status           DisputeStatus  @default(OPEN)
  reason           String
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([serviceRequestId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorUserId  String?
  actorRole    Role?
  onBehalfOfUserId String?
  action       String // e.g. SERVICE_REQUEST_TRANSITION, REFUND_APPROVED
  entityType   String
  entityId     String
  before       Json?
  after        Json?
  ipAddress    String?
  requestId    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// Idempotent POST handling for payments/orders: stores response snapshot for replay.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String
  userId       String
  endpoint     String
  requestHash  String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([key, userId, endpoint])
}

// Admin-configurable pricing per emirate/zone.
model PricingConfig {
  id              String   @id @default(cuid())
  emirate         String
  baseRecoveryFee Decimal  @db.Decimal(12, 2)
  perKmFee        Decimal  @db.Decimal(12, 2)
  diagnosticFee   Decimal  @db.Decimal(12, 2)
  platformFeeRate Decimal  @default(0.05) @db.Decimal(5, 4)
  vatRate         Decimal  @default(0.05) @db.Decimal(5, 4)
  currency        String   @default("AED")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([emirate, isActive])
}
