# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sanad:sanad_dev_password@localhost:5432/sanad?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (generate strong random values; never commit real secrets) ---
JWT_ACCESS_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-2
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Object storage (MinIO in dev; any S3-compatible store in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET=sanad-media
S3_ACCESS_KEY=sanad
S3_SECRET_KEY=sanad_dev_password
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_BYTES=26214400      # 25 MB

# --- External providers (REQUIRES-EXTERNAL: real credentials + approvals) ---
SMS_PROVIDER=mock             # mock | (twilio/unifonic adapters to be added)
PAYMENT_PROVIDER=mock         # mock | (stripe/telr/checkout adapters to be added)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PUSH_PROVIDER=mock            # mock | fcm
GEO_PROVIDER=haversine        # haversine | google | mapbox
